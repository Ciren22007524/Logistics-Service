# 複製成 .env：cp .env.example .env，再填 CREDENTIALS_ENC_KEYS 與 OIDC 設定
APP_ENV=development
LOG_LEVEL=info
HOST=127.0.0.1
PORT=4310
# 物流商回調、選店導回都用這個網址；物流商要能連到（本機測真實回調可用 ngrok / cloudflared）
PUBLIC_BASE_URL=http://localhost:4310
# 後台頁面由後端直接提供（web/dist），開 http://localhost:4310 即可；背景任務預設也在同一個程序內
# SERVE_WEB=true
# RUN_WORKER=true
# 只有另開 Vite 熱更新（npm run dev:web）時才需要：
# ADMIN_WEB_URL=http://localhost:5310
# OIDC_REDIRECT_URI=http://localhost:5310/auth/callback

# --- 基礎服務（docker compose 預設連接埠） ---
DATABASE_URL=postgresql://logistics:logistics-local-only@127.0.0.1:25432/logistics
REDIS_URL=redis://127.0.0.1:26379
S3_ENDPOINT=http://127.0.0.1:29000
S3_BUCKET=logistics-labels
S3_ACCESS_KEY_ID=logistics
S3_SECRET_ACCESS_KEY=logistics-local-only
LABEL_URL_TTL_SECONDS=300

# 物流商金鑰加密（AES-256-GCM），npm run gen:key 產生；不要進版控
# 輪替：新金鑰放第一把、舊的留後面 → npm run credentials:rotate → 移除舊金鑰
CREDENTIALS_ENC_KEYS=

# --- 登入：auth-service（標準 OIDC） ---
# 到 auth-service 的 /register 以「後端」模式註冊，回呼填 http://localhost:4310/auth/callback
# （預設為 PUBLIC_BASE_URL + /auth/callback，需與註冊值完全相同）
OIDC_ISSUER=http://localhost:3000
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPES=openid email profile
# 有在 auth-service 登記 post_logout_redirect_uris 才設定
# OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:4310/login
# 後台授權：email 白名單或 auth-service UserInfo roles 任一符合；兩者都空時只有非 production 放行所有登入者
ADMIN_EMAILS=
ADMIN_ROLES=
# 尚未註冊 OIDC client 時，本機可暫時直接登入（只在 development/test 有效）
AUTH_DEV_BYPASS=false

# --- Worker ---
POLL_TRACKING_CRON=17 * * * *
POLL_TRACKING_STALE_HOURS=2
STALE_ALERT_CRON=5 9 * * *
CVS_EXPIRY_CRON=35 9 * * *
SUBMIT_MAX_ATTEMPTS=6
# 告警推播（Slack/Discord 相容 JSON {text}）；未設只寫 log
# ALERT_WEBHOOK_URL=
# MOCK 模擬物流商：production 預設關閉
# ENABLE_MOCK_CARRIER=true
