{
  "name": "logistics-service",
  "version": "0.1.0",
  "private": true,
  "description": "物流管理平台：統一 API、多物流商 adapter、狀態機、回調與 webhook",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run build:web && tsx watch --env-file-if-exists=.env src/main-api.ts",
    "dev:api": "tsx watch --env-file-if-exists=.env src/main-api.ts",
    "dev:worker": "tsx watch --env-file-if-exists=.env src/main-worker.ts",
    "dev:web": "npm --workspace web run dev",
    "build": "npm run build:api && npm run build:web",
    "build:api": "tsc -p tsconfig.build.json",
    "build:web": "npm --workspace web run build",
    "start": "node --env-file-if-exists=.env dist/main-api.js",
    "start:worker": "node --env-file-if-exists=.env dist/main-worker.js",
    "start:migrate": "node --env-file-if-exists=.env dist/main-migrate.js",
    "db:migrate": "tsx --env-file-if-exists=.env src/main-migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env scripts/seed.ts",
    "credentials:rotate": "tsx --env-file-if-exists=.env scripts/rotate-credentials.ts",
    "gen:key": "node -e \"console.log(require('node:crypto').randomBytes(32).toString('base64'))\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/e2e"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1167.0",
    "@aws-sdk/s3-request-presigner": "^3.1167.0",
    "@fastify/cookie": "^11.1.5",
    "@fastify/formbody": "^8.0.2",
    "@fastify/static": "^8.3.0",
    "bullmq": "^5.81.5",
    "fastify": "^5.12.8",
    "ioredis": "^5.11.1",
    "openid-client": "^6.8.9",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.1",
    "pino": "^9.14.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "@types/oidc-provider": "^9.13.1",
    "@types/pg": "^8.23.1",
    "eslint": "^9.39.5",
    "globals": "^17.14.0",
    "oidc-provider": "^9.14.0",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^3.2.7"
  },
  "workspaces": [
    "web"
  ]
}
